rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if validScore();
      allow update: if validScore() && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','score','at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 14
        && d.score is int && d.score >= 0 && d.score <= 100000
        && d.at is int;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
